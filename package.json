{
  "name": "reptoc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --outDir dist/client && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=build/server.cjs",
    "preview": "vite preview",
    "start": "node build/server.cjs",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('build',{recursive:true,force:true}); fs.rmSync('server.js',{force:true});\"",
    "lint": "tsc --noEmit",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:migrate:status": "node scripts/run-migrations.mjs --status",
    "test:smoke": "node scripts/api-smoke-test.mjs",
    "test:worldbuilding": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:ads": "node --import tsx --test tests/advertisements.test.tsx",
    "test:e2e:worldbuilding": "tsx scripts/worldbuilding-e2e.mts",
    "test:username-migration": "node --import tsx scripts/test-username-migration.mts",
    "test:username": "REDIS_URL= RUN_USERNAME_DB_TESTS=1 node --import tsx --test tests/username-feature.test.ts tests/username-identity-db.test.ts",
    "test:username-api": "node scripts/username-api-smoke.mjs"
  },
