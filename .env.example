# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# Public canonical HTTPS origin, without a trailing slash. This value is used
# for sitemap and robots.txt URLs (for example, https://reptoc.ir).
APP_URL=
CORS_ORIGIN=
ALLOWED_ORIGINS=

# Google OAuth 2.0 Web application credentials.
# Add this exact callback to Google Cloud Console > Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

HOST=
PORT=

# PostgreSQL Configuration
# Prefer DATABASE_URL in production. If it is absent, the app reads PGHOST, PGPORT,
# PGDATABASE, PGUSER, and PGPASSWORD.
DATABASE_URL=
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
# Set PGSSLMODE=require or PGSSL=true when your provider requires TLS.
PGSSLMODE=

# JWT Secret
JWT_SECRET=

# Stable 32-byte encryption key encoded as 64 hex characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
NODE_ENV=

# Email Configuration
# Optional provider selector: resend, mailjet, or smtp.
# If EMAIL_PROVIDER is empty, the app uses the first complete provider config
# in this order: Resend, Mailjet, SMTP.
EMAIL_PROVIDER=

# Nodemailer/SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# Optional Mailjet API configuration. If Mailjet API and SMTP are both complete,
# the app sends verification emails through Mailjet API first.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=

# Optional Resend REST API configuration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# Cloud Storage (S3 / R2 compatible)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=

# Optional upload malware scanning via ClamAV clamd.
# When CLAMAV_HOST is absent, uploads still run strict local heuristic checks.
CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_TIMEOUT_MS=

# Optional analytics IP intelligence.
# Country/device analytics never stores raw IP addresses; it stores a SHA-256 hash.
# VPN/proxy/hosting traffic is marked as "Untraceable" in author analytics.
GEOIP_TIMEOUT_MS=

# Discord chapter announcements.
# Create a bot in Discord Developer Portal, invite it to the guild with Send Messages
# and Embed Links permissions, then set the token in your real .env file.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ANNOUNCEMENT_CHANNEL_ID=
# Optional comma-separated additions or false-positive exceptions for the
# registration disposable-email domain check.
DISPOSABLE_EMAIL_DOMAINS=
DISPOSABLE_EMAIL_ALLOW_DOMAINS=
